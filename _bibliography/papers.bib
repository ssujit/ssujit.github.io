@phdthesis{uddinVisualizationSpatialDisparities2022,
	address = {Dresden, Germany},
	title = {Visualization of spatial disparities in mobility service frequency with open public transit feed data in {Germany}},
	abstract = {Open data is a blessing to modern scientific exploration. This study was conducted using General Transit Feed Specification (GTFS) data of Germany. GTFS data has the potential to explore spatial disparities as it covers hourly data. Along with this OpenStreetMap and administrative data have been used in this study. This thesis seeks to visualize spatial disparities in mobility service frequency in a web-based map. A reproducible workflow for raw GTFS data processing has been developed in this study. Nevertheless, there is still scope for improvement in the designed workflow, especially Distance Indicator modeling needs quick processing. A systematic literature review process was adopted to find the state of the art. Data and visualization designs have been adopted from the literature. PubTraDisVisualizationis the outcome of the study that uses ArcGIS online-based Dashboard technology. The user-centered design process has been followed in PubTraDisVisualization. Data and visualization designs have been adopted from the literature. The tool is suitable to perform comparisons between different Municipalities as well as between weekdays and weekends, and different times of the day. The commonly used disparity index Local Moran’s Index has been calculated to show spatial disparities in grid-level Frequency Indicators. The expert-based evaluation shows that this tool would contribute to spatial disparity analysis in public transit research. However, there is scope for improvement in the current state of PubTraDisVisualization. Handling automatic updates of the GTFS data can be an important improvement of this tool.},
	language = {en},
	school = {Dresden University of Technology},
	author = {Uddin, Imtiaz},
	month = dec,
	year = {2022},
	file = {PDF:C\:\\Users\\user\\Zotero\\storage\\4S4AU3IE\\Uddin - Visualization of spatial disparities in mobility service frequency with open public transit feed dat.pdf:application/pdf},
}

@phdthesis{rahamanIntegratingLocalLarge2026,
	address = {Sttutgart, Germany},
	title = {Integrating {Local} {Large} {Language} {Models} into {WebGIS}: {A} {Framework}  for {Natural} {Language} {Interaction}},
	abstract = {WebGIS applications are widely used, but the useability is often challenging for users with limited GIS experience. Large language models make it easier to ask location-related questions, yet many GeoAI prototypes are cloud-based and give little control over the model. This thesis investigates the use of a locally deployed language model to support WebGIS interaction in a controlled way. A chat-based WebGIS prototype was implemented in which user messages are translated into geospatial actions, such as loading data, zooming to a place, filtering features, counting features, measuring distances and more. The model runs locally via Ollama and is used only to propose actions, which are validated against a JSON schema before execution. The prototype is evaluated on a parking dataset from the MobiData Baden-Württemberg platform and the results indicate that the local model can interpret natural language queries well enough to enable controlled WebGIS interaction with acceptable response times.},
	language = {en},
	school = {Sttutgart University of Applied Sciences},
	author = {Rahaman, Ashifur},
	year = {2026},
	file = {PDF:C\:\\Users\\user\\Zotero\\storage\\J52Z4F7E\\Rahaman - 2026 - Integrating Local Large Language Models into WebGIS A Framework  for Natural Language Interaction.pdf:application/pdf},
}

