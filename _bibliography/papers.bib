	issn = {2661-8001},
	url = {https://www.nature.com/articles/s42949-021-00042-w},
	doi = {10.1038/s42949-021-00042-w},
	abstract = {Abstract Recent years have seen a massive development of geospatial sensing systems informing the use of space. However, rarely do these sensing systems inform transformation towards urban sustainability. Drawing on four global urban case examples, we conceptualize how passive and active sensing systems should be harnessed to secure an inclusive, sustainable and resilient urban transformation. We derive principles for stakeholders highlighting the need for an iterative dialogue along a sensing loop, new modes of governance enabling direct feeding of sensed information, an account for data biases in the sensing processes and a commitment to high ethical standards, including open access data sharing.},
	language = {en},
	number = {1},
	urldate = {2023-09-18},
	journal = {npj Urban Sustainability},
	author = {Grêt-Regamey, Adrienne and Switalski, Michal and Fagerholm, Nora and Korpilo, Silviya and Juhola, Sirkku and Kyttä, Marketta and Käyhkö, Niina and McPhearson, Timon and Nollert, Markus and Rinne, Tiina and Soininen, Niko and Toivonen, Tuuli and Räsänen, Aleksi and Willberg, Elias and Raymond, Christopher M.},
