@article{zhaoResearchCampusBike2016,
	title = {Research on {Campus} {Bike} {Path} {Planning} {Scheme} {Evaluation} {Based} on {TOPSIS} {Method}: {Wei}'shui {Campus} {Bike} {Path} {Planning} as an {Example}},
