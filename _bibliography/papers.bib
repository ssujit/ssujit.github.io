	editor = {Tsai, F. and Gruen, A. and Safar, V. and Gong, J. and Hanzl, V. and Wu, H. and Wang, L. and Halounova, L. and Vyas, A. and Musikhin, I. and Kanjir, U. and Faltynova, M.},
	year = {2016},
	keywords = {Open data, Education, Open source software, Data handling, Remote sensing, Open source, Open sources, Curricula, Students, Digital storage, Distributed computer systems, Cloud based GIS, Cloud-based, Computing environments, Desktop software, Embedded systems, Geospatial science, Learning materials, Open datum, Teaching, Teaching and learning, Ubiquitous computing},
	pages = {25--29},
}

