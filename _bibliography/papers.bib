@misc{sikder2025Transitioncarbasedhumanmobility,
  title = {Transition of Car-Based Human-Mobility in the Pandemic Era: {{Data}} Insight from a Cross-Border Region in {{Europe}}},
  shorttitle = {Transition of Car-Based Human-Mobility in the Pandemic Era},
  author = {Sikder, Sujit Kumar and Ijaradar, Jyotirmaya and Li, Hao and Omrani, Hichem},
  year = 2025,
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2509.05166},
  urldate = {2026-10-20},
  abstract = {Many transport authorities are collecting and publishing almost real-time road traffic data to meet the growing trend of massive open data, a vital resource for foresight decision support systems considering deep data insights. We explored the spatio-temporal transitions in the cross-country road traffic volumes in the context of modelling behavioural transitions in car-based human mobility. This study reports on individual car-based daily travel behaviour detected, before (2018) and during the COVID pandemic (2020), between Germany and neighbouring countries. In the case of Luxembourg, the Bridges and Roads Authority has installed a large digital traffic observatory infrastructure through the adoption of sensor-based IoT technologies, like other European member states. Since 2016, they have provided high-performance data processing and published open data on the country's road traffic. The dataset contains an hourly traffic count for different vehicle types, daily for representative observation points, followed by a major road network. The original dataset contains significant missing entries, so comprehensive data harmonization was performed. We observed the decrease in traffic volumes during pandemic factors (e.g. lockdowns and remote work) period by following global trend of reduced personal mobility. The understanding the dynamic adaptive travel behaviours provide a potential opportunity to generate the actionable insight including temporal and spatial implications. This study demonstrates that the national open traffic data products can have adoption potential to address cross-border insights. In relevance to the net-zero carbon transition, further study should shed light on the interpolation and downscaling approaches at the comprehensive road-network level for identifying pollution hot spots, causal link to functional landuse patterns and calculation of spatial influence area.},
  copyright = {Creative Commons Attribution 4.0 International},
  keywords = {Computers and Society (cs.CY),FOS: Computer and information sciences,Human-Computer Interaction (cs.HC)}
}

@article{sikder2026Openpublictransit,
  title = {Open Public Transit Plan Data: {{Geoprocessing}} and Spaital Analysis},
  shorttitle = {Open Public Transit Plan Data},
  author = {Sikder, Sujit Kumar},
  year = 2026,
  month = oct,
  publisher = {Zenodo},
  doi = {10.5281/ZENODO.23500423},
  urldate = {2026-10-20},
  abstract = {Dive into the fascinating realm of geoprocessing workflow and advanced spatial analysis with our comprehensive teaching material centered around the rich dataset provided by MDV - Local Public Transport in Central Germany. This educational resource is designed to empower learners, researchers, and professionals to unlock the full potential of open public transit data for spatial analytics. The case study area, situated within the operational domain of MDV, serves as a real-world backdrop for understanding and implementing geospatial techniques. The teaching material takes participants on a journey through the geoprocessing workflows, offering a step-by-step guide to harnessing the power of open data to derive meaningful insights. Key Highlights: Data Exploration: Learn to navigate and understand the intricacies of open public transit data. Explore the wealth of information provided by MDV, gaining insights into transportation offers, station density, and spatial relationships. Geoprocessing Techniques: Delve into fundamental geoprocessing techniques, from data cleaning and preprocessing to spatial indexing and spatial querying. Understand how to handle geographic data effectively, ensuring accuracy and reliability in subsequent analyses. Spatial Statistics: Elevate your spatial analysis capabilities with advanced statistical techniques. Analyze spatial patterns, detect clusters, and derive meaningful conclusions that can inform strategic planning and policy development within the Central German transportation context. Case Study Applications: Apply acquired knowledge to real-world scenarios within the MDV operational area. Explore case studies that demonstrate the practical applications of geoprocessing workflows and advanced spatial analysis in optimizing public transit systems and addressing regional transportation challenges. This teaching material is crafted to cater to a wide audience, from beginners seeking an introduction to geospatial analysis to seasoned professionals aiming to enhance their skill set. Embark on this educational journey and unlock the transformative potential of open public transit data in shaping the future of transportation in Central Germany.},
  copyright = {Creative Commons Attribution Share Alike 4.0 International},
  langid = {english},
  keywords = {Germany,GTFS feed,open data,Public transport,spatial analysis,transit plan data}
}

@article{sikderGeospatialAnalysisBuilding2019,
  title = {Geospatial {{Analysis}} of {{Building Structures}} in {{Megacity Dhaka}}: The {{Use}} of {{Spatial Statistics}} for {{Promoting Data}}-Driven {{Decision}}-Making},
  shorttitle = {Geospatial {{Analysis}} of {{Building Structures}} in {{Megacity Dhaka}}},
  author = {Sikder, Sujit Kumar and Behnisch, Martin and Herold, Hendrik and Koetter, Theo},
  year = 2019,
  month = apr,
  journal = {Journal of Geovisualization and Spatial Analysis},
  volume = {3},
  number = {1},
  pages = {7},
  issn = {2509-8829},
  doi = {10.1007/s41651-019-0029-y},
  urldate = {2025-12-22},
  abstract = {Information on spatial building structures is limited, but it can support efficient planning and management in the context of fast-growing big cities in many developing countries. In this paper, we present a spatial analysis approach that includes an estimate of building intensity in the megacity of Dhaka and a spatial analysis using spatial statistics. The entire city was divided into regular grids and the building intensity (both horizontal and vertical) was extracted using vector type building information; the spatial statistics were calculated on the basis of Moran's I and Gini indices. The variability of the estimated spatial statistics is interpreted according to co-relationship or clustering patterns with the location of the central business district (CBD) area as well as the public bus transit infrastructure (routes and stops). The results show that the residential building structure intensity is prominent and the concentrations are distributed all over the city. The mixed-use type building structures show highest clustering, with fewer outliers in the old part of the city. The vertical-use intensities indicate extreme clustering within highly intensified building activity in the nearby CBD area. The higher presence of low-low clustering of horizontal intensity indicated low development at the suburban area. However, the strongly clustered grid cells within residential sector as well as horizontal development classes are less accessible by bus transit within a defined catchment area, whereas the service sector and vertical development type seem to be more accessible. This type of geographic approach, visualization, and statistical information can help in making data-driven planning decisions with the advantage of monitoring urban development; however, the modeling sensitivity and uncertainties in the building data set remain open for further investigation.},
  langid = {english},
  keywords = {Building structure,Geographical information system,Megacity,Spatial analysis,Spatial statistics},
  file = {C:\Users\user\Zotero\storage\57ZQ9NVJ\Sikder et al. - 2019 - Geospatial Analysis of Building Structures in Megacity Dhaka the Use of Spatial Statistics for Prom.pdf}
}

@article{sikderGeospatialApproachDownscaling2018,
  title = {A Geospatial Approach of Downscaling Urban Energy Consumption Density in Mega-City {{Dhaka}}, {{Bangladesh}}},
  author = {Sikder, S. K. and Nagarajan, M. and Kar, S. and Koetter, T.},
  year = 2018,
  month = dec,
  journal = {Urban Climate},
  volume = {26},
  pages = {10--30},
  issn = {2212-0955},
  doi = {10.1016/j.uclim.2018.08.004},
  urldate = {2025-12-22},
  abstract = {Lack of energy consumption data limits resource optimized urban structure and energy planning in developing countries like Bangladesh. Focusing on mega-city Dhaka as a case, this study applies a geospatial approach of using multi-source national and regional datasets and visual analytics to downscale and estimate energy consumption at a local scale (such as ward and gridcell). The energy consumption density (ECD), as a measure of end energy use in a unit area, was estimated and mapped by linking building floorspace data with residents' energy use indicators such as per capita energy consumption, household energy expenditure, and mobility (transportation) pattern. This study also evaluated the ECD modelling outputs, and their sensitivity to distance from central business district (CBD) and total building floorspace. Results found a positive correlation between the residential building floorspace and estimated ECD. Regression and sensitivity analysis also identified and mapped significant spatial clusters and outliers in estimated ECD pattern of Dhaka city. This approach and methodology could help similar cities in other developing countries adopt and implement energy focused urban development.},
  keywords = {Energy consumption density,Geo-spatial modelling,GIS,Spatial Analysis,Urban energy},
  file = {C\:\\Users\\user\\Zotero\\storage\\VDVYR4C3\\Sikder et al. - 2018 - A geospatial approach of downscaling urban energy consumption density in mega-city Dhaka, Bangladesh.pdf;C\:\\Users\\user\\Zotero\\storage\\YB28QZSD\\S2212095518301676.html}
}

