@article{meinel2026FAIRSocialSpatialScience,
  title = {A {{FAIR Social-Spatial Science Research Data Infrastructure}}},
  author = {Meinel, Gotthard and Goebel, Jan and J{\"u}nger, Stefan and Zapilko, Benjamin and Rieche, Theodor and Jung, Alexander and Lieth, Jonas and Sikder, Sujit Kumar and Nieswand, Maria},
  year = 2026,
  month = jun,
  publisher = {Zenodo},
  doi = {10.5281/ZENODO.20717129},
  urldate = {2026-10-20},
  abstract = {The integration of social survey and spatial data is a prerequisite for cross-domain research but is constrained by infrastructural, legal, and methodological challenges. The Geolinking Service SoRa addresses these by providing a long-term, privacy-compliant research data infrastructure that links social science survey data with georeferenced spatial information. This poster introduces SoRa's key infrastructure components: a user module, a public/private-mode API, a Geolinking API, and an R package to support user workflows. SoRa implements multiple geolinking methods---point-to-point, buffer, isochrone-based, and routing to the nearest point of interest (e.g., schools, hospitals)---and provides structural (synthetic) datasets that mirror spatial distributions for workflow testing without exposing sensitive data. By promoting FAIR and inclusive data integration, SoRa establishes a robust foundation for interdisciplinary, data-driven research. Explore more details on our website: https://sora-service.org/en},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {english},
  keywords = {Geolinking,NFDI4Earth Plenary 2026,Research data infrastructure,spatial data infrastructure}
}

