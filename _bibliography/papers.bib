@article{hemmingsNASASpaceApps2019,
	title = {The {NASA} space apps challenge: leveraging the world's largest hackathon for crowdsourcing and citizen science},
	volume = {2019},
	shorttitle = {The {NASA} {Space} {Apps} {Challenge}},
	url = {https://ui.adsabs.harvard.edu/abs/2019AGUFMIN51E0683H},
	abstract = {A thriving example of crowdsourcing and citizen science, the NASA International Space Apps Challenge is a yearly event in which teams around the world use NASA's open data to develop innovative solutions to challenges in Earth and space science and technology. Known as "the world's largest global hackathon," Space Apps maintains a small global infrastructure and relies on the intense commitment of local organizers around the world to develop, fund, and manage their local events, using information and tools that NASA provides. Each year, NASA releases individual challenge statements in support of a yearly theme, and in 2018, the theme was "Earth and Space." Space Apps' global network fosters collaborations across borders, sectors and populations, as diverse teams of scientists, software developers, technologists, and others from non-traditional hackathon audiences convene to collaborate on open-source solutions to each year's challenges. Participation is growing worldwide: approx. 18,000 people in 200 cities across 75 countries participated in 2018, and the hashtag \#SpaceApps had a reach of over 49 million people. Outcomes include new Earth and space science applications, increased awareness of Earth and space observations, the creation of new communities of collaboration, workforce development, and rising engagement of women. As a highly successful crowdsourcing and citizen science endeavor, Space Apps utilizes NASA's open data to engage broad communities of innovators around the world; these innovators craft solutions that foster a better understanding of Earth and space science and help to improve life on Earth. This presentation will look to the future and the past to explore the development, growth, and elements of success inherent in the Space Apps Challenge in the contexts of crowdsourcing, citizen science, use of Earth and space science data, and science diplomacy.},
	urldate = {2023-09-18},
	author = {Hemmings, S. N. and Gupta, S. S. and Mysore, A. and Bontempi, P. S. and Jacobberger-Jellison, P. A.},
	month = dec,
	year = {2019},
	keywords = {BIOGEOSCIENCES, INFORMATICS},
	pages = {IN51E--0683},
}

