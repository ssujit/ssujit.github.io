@incollection{sikder2018Infrastrukturplanungmitverkehrsbezogenen,
  title = {{Infrastrukturplanung mit verkehrsbezogenen Fl\"achennutzungsindikatoren}},
  author = {Sikder, Sujit Kumar and Herold, Hendrik and Meinel, Gotthard},
  year = 2018,
  publisher = {Zenodo},
  doi = {10.5281/ZENODO.23497572},
  urldate = {2026-10-20},
  abstract = {Die Geodatendienste des I\"OR-Monitors stellten bundesweit Indikatoren zur Fl\"achennutzungsstruktur sowie der verkehrsbezogenen Infrastruktur bereit. Diese Daten k\"onnen unter anderem f\"ur die Infrastrukturplanung genutzt werden. Ziel dieses Beitrages ist es, die r\"aumliche Variabilit\"at der aktuellen Ladestationspunkte (Electric Vehicle Charging Points: ECP) als Teil der zuk\"unftigen Elektromobilit\"atsinfrastruktur bundesweit zu analysieren. Die explorative Analyse wird auf Kreisebene mithilfe eines hybriden Datensatzes, d. h. einer Kombination von offenen, amtlichen und nutzergenerierten (VGI) Daten-quellen durchgef\"uhrt. Sie umfasst die Analyse der Datenqualit\"at, die Extraktion r\"aumlicher Muster sowie die Erstellung deskriptiver Statistiken. Die h\"ochste Konzentration von ECP gibt es erwartungsgem\"a\ss{} in den Gro\ss st\"adten, davon am meisten in den gro\ss en Ballungsr\"aumen. Die bivariate Korrelationsanalye zeigt, dass der Anteil Verkehrsfl\"ache an Gebietsfl\"ache eine robuste Pr\"adiktorvariable des I\"OR-Monitors ist. Zur Erstellung deskriptiver Statistiken, zur Extraktion r\"aumlicher Muster und deren Darstellung in Karten und Grafiken wurden ausschlie\ss lich offene und frei verf\"ugbare analytische Softwarewerkzeuge eingesetzt. ~ EN:~ --- The geospatial services of the I\"OR-Monitor provided nationwide indicators of land-use structure and transport-related infrastructure. These data can be used, among other purposes, for infrastructure planning. The aim of this paper is to analyse the spatial variability of existing electric vehicle charging points (ECPs) nationwide as part of the future electric mobility infrastructure. The exploratory analysis is conducted at the district level using a hybrid dataset, i.e., a combination of open, official, and volunteered geographic information (VGI) data sources. It includes an assessment of data quality, the extraction of spatial patterns, and the generation of descriptive statistics. As expected, the highest concentrations of ECPs are found in large cities, particularly in major metropolitan areas. The bivariate correlation analysis shows that the proportion of transport land relative to the total area is a robust predictor variable provided by the I\"OR-Monitor. Open-source and freely available analytical software tools were used exclusively to generate descriptive statistics, extract spatial patterns, and visualise the results using maps and charts.},
  copyright = {Creative Commons Attribution Share Alike 4.0 International},
  langid = {ngerman},
  keywords = {electric vehicle charging stations,spatial analysis,transport infrastructure planning,Volunteered geographic stations}
}

@article{sikder2019Measuringurbanhuman,
  title = {{Measuring urban human activity intensity in the context of data scarcity}},
  author = {Sikder, Sujit Kumar and Herold, Hendrik and Meinel, Gotthard and Rahman, Md Ashiq Ur},
