	keywords = {Computer software, Geographic information systems, Random access storage, Remote sensing, Algorithms, Computer hardware, Data processing, Earth observation system (EOS), Geostationary satellites, Meteorology, NASA (National Aeronautics and Space Agency), Ozone layer, Ozone monitoring instrument (OMI), Parallel processing systems, Science investigator-led processing system (SIPS), Spectroscopic analysis, Troposphere, UNIX},
