@inproceedings{kurzKiWiPlatformBuilding2010,
	title = {{KiWi} - {A} platform for building semantic social media applications},
	volume = {658},
	isbn = {16130073 (ISSN)},
	abstract = {The combination of semantic technologies and social software has become more and more popular in the last few years as can be seen by the emergence of Semantic Wikis or the popularity of vocabularies such as FOAF or SIOC. The KiWi project is based upon these principles and offers features required for Social Media applications such as versioning, (semantic) tagging, rich text editing, easy linking, rating and commenting, as well as advanced "smart" services such as recommendation, rule-based reasoning, information extraction, intelligent search and querying, a sophisticated social reputation system, vocabulary management, and rich visualization. KiWi can be used both, as a platform for building custom Semantic Media applications, and as a Semantic Social Index, integrating content and data from a variety of different sources, e.g. Wikis, blogs and content management systems in an enterprise internet. Third-party applications can access the KiWi System using simpleto- use web services. The demo presents the whole functionality of the Open Source development platform KiWi in its final version within one integrated project management scenario. Furthermore it shows different KiWi-based Social Media projects to illustrate its various fields of application.},
	language = {English},
	booktitle = {{CEUR} {Workshop} {Proceedings}},
	author = {Kurz, T. and Schaffert, S. and Bürger, T. and Stroka, S. and Sint, R. and Radulescu, M. and Grünwald, S.},
	year = {2010},
	keywords = {Search engines, Semantics, Information management, Web services, Abstracting, Birds, Content management system, File editors, Fruits, Intelligent search, Management scenarios, Open source development, Rule based reasoning, Semantic technologies, Semantic Web, Third party application (Apps), Vocabulary management},
	pages = {185--188},
}

@article{kumarIntegratedPlanningSustainable2016,
	title = {Integrated {Planning} for {Sustainable} {Development} of {Kuttanad} {Wetland} {Region}, {Kerala} {State}},
	volume = {24},
	doi = {10.1016/j.protcy.2016.05.185},
	abstract = {The planning process for Wetland Regions is often considered under regional plans and often involves a team of consultants including urban planners, environment engineers and representations from various departments. Their role in the ecological and environmental well-being of any living system is unparalleled. With increasing urbanization, the limits of these regions are often affected with increased human habitations coming up in such sites including the example of Kuttanad wetland region. Their isolated planning process often could lead to worsening of existing situation or newer challenges paving ways for possible disasters. The paper examines the present situation in Kuttanad Region and discusses similar situations in the Indian and global context. It also recommends the systems approach for problem mapping and suggests possible recommendations for sustainable planning. In the light of climate change and increased awareness about sustainability, one can utilize planning as a tool to integrate ‘aspirations for growth’ as a decisive measure for the planning of cities and analyse it utilizing existing mechanisms for planning without suggesting drastic overhaul of the existing system.},
	journal = {Procedia Technology},
	author = {Kumar, Sanil and Devadas, V.},
	year = {2016},
	pages = {1660--1667},
}

