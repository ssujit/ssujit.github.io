@article{khanCitizenGovernmentCoproduction2020,
	title = {Citizen and government co‐production of data: analyzing the challenges to government adoption of {VGI}},
	volume = {64},
	issn = {0008-3658, 1541-0064},
	shorttitle = {Citizen and government co‐production of data},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/cag.12619},
	doi = {10.1111/cag.12619},
	abstract = {With the recent rise of open government and open data initiatives, governments are increasingly adopting new approaches of citizen participation to support a more democratic, transparent, and inclusive government system. Among other forms of citizen participation, Volunteered Geographic Information (VGI) is one approach to connecting citizens and government. Accepting VGI as a way to update government data or collect near‐real‐time information from citizens can create a partner‐like relationship where citizens voluntarily contribute time and effort to support government actions. However, as a relatively new approach to citizen participation and data collection, VGI requires evaluation from the perspective of governments. This research investigates the challenges and opportunities that governments have found through the implementation of VGI projects. Results are drawn from interviews conducted with 19 government organizations, revealing organizational and technical challenges that limit the adoption of VGI. Organizational challenges are associated with government mindset, implementation, and project management, while technical challenges involve development of the system and quality of data. Given these challenges, we derive recommendations within the phases of project initiation, implementation, and expansion that can foster VGI adoption in government. , La coproduction de données par les citoyens et le gouvernement : une analyse des défis reliés à l'adoption de la cartographie participative par le gouvernement À la suite du développement récent de projets en matière de gouvernement ouvert et de données ouvertes, les gouvernements adoptent de plus en plus de nouvelles approches de participation citoyenne pour appuyer un système gouvernemental plus démocratique, transparent et inclusif. Parmi les diverses formes de participation citoyenne, la cartographie participative (CP) est une approche visant à rapprocher les citoyens et le gouvernement. La mise en place de la CP comme moyen de mettre à jour les données gouvernementales ou de collecter de l'information en temps quasi réel auprès des citoyens peut créer une relation de type partenarial où les citoyens investissent volontairement du temps et des efforts. Toutefois, à titre d'approche relativement nouvelle à l'égard de la participation citoyenne et de la collecte de données, la CP requiert davantage d'études du point de vue des gouvernements pour la mise en œuvre de projets. La présente recherche s'interroge sur les défis et les possibilités liés à la réalisation de projets de CP par le gouvernement. Les résultats sont tirés d'entrevues effectuées auprès de 19 organisations gouvernementales qui ont fait ressortir les défis organisationnels et techniques qui limitent l'adoption de la CP. Les défis organisationnels sont associés à la mentalité gouvernementale et à la mise en œuvre et la gestion de projets alors que les défis techniques impliquent le développement du système et de la qualité des données. En raison de ces défis, nous formulons des recommandations dans les domaines de la mise en place, de l'opérationnalisation et du développement qui peuvent favoriser l'adoption de la CP au sein du gouvernement. , Key Messages Different organizational and technical challenges emerge at different phases of VGI adoption in government. Challenges occur throughout the development process; however, many of them resolve with time and experience. Using VGI in government requires improved practices within the phases of initiation, implementation, and expansion.},
	language = {en},
	number = {3},
	urldate = {2023-09-18},
	journal = {Canadian Geographies / Géographies canadiennes},
	author = {Khan, Zarin T. and Johnson, Peter A.},
	month = sep,
	year = {2020},
	pages = {374--387},
}

