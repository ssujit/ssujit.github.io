	title = {{ePortfolio}: {An} {eWay} of showcasing the artifacts},
	isbn = {9781457707261 (ISBN)},
	doi = {10.1109/ICTEE.2012.6208672},
	abstract = {An ePortfolio or an electronic portfolio is a web-based information management system that uses electronic media and services. The learner builds and maintains a digital repository of artifacts, which they can use to demonstrate competence and reflect on their learning. Having access to their records, digital repository, feedback and reflection students can achieve a greater understanding of their individual growth, career planning and CV building. Accreditation for prior and/or extra-curricular experiences and control over access makes the ePortfolio a powerful tool. The software development of ePortfolio module was awarded to IGNOU under the Education Resource Planning (EdRP) project, an extension to the Brihaspati-3 (an open source learning management system) under the National Mission on Education through Information and Communication Technology (NME-ICT) initiative of Ministry of HRD, Government of India. In this paper, we intend to discuss the significance of ePortfoio, the details like the mindmap, data flow diagrams, architecture of the ePortfolio module, the issues and the challenges faced during and due course of its development. © 2012 IEEE.},
	language = {English},
	booktitle = {Proceedings - 2012 {IEEE} {International} {Conference} on {Technology} {Enhanced} {Education}, {ICTEE} 2012},
	author = {Subrahmanyam, V. V. and Kanjilal, U. and Sharma, V. K. and Dudeja, A. K.},
	year = {2012},
	keywords = {Open systems, Information technology, Access control, Accreditation, Career planning, Curricula, Data flow diagrams, Digital repository, E-portfolios, EdRP, Education resource, Electronic document exchange, Electronic media, Electronic portfolios, Engineering education, ePortfolio, Government of India, Information and Communication Technologies, Information management, National mission, NME-ICT, Open-source learning, Web-based information},
}

