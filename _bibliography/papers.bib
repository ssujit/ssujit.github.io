	keywords = {geodata infrastructure (GDI), indicators, LULC, open science, research data infrastructure (RDI), spatial science},
	pages = {159--170},
	file = {Full Text PDF:C\:\\Users\\user\\Zotero\\storage\\ETKWM5QB\\Meinel et al. - 2022 - IOER Monitor A Spatio-Temporal Research Data Infrastructure on Settlement and Open Space Developmen.pdf:application/pdf},
